{
  "plugins": ["plugins/markdown", "jsdoc-plugin-typescript"],
  "recurseDepth": 10,
  "source": {
    "include": ["src", "README.md"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "readme": "README.md"
  }
}
